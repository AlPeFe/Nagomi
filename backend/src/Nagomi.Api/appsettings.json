{
  "ConnectionStrings": {
    "Nagomi": "Host=localhost;Port=5432;Database=nagomi;Username=nagomi;Password=nagomi"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "ProviderIntegration": {
    "RabbitMq": {
      "Uri": "amqp://guest:guest@localhost:5672",
      "Exchange": "nagomi.provider.notifications",
      "DeadLetterExchange": "nagomi.provider.notifications.dead",
      "RetryDelay": "00:01:00",
      "PollInterval": "00:00:10",
      "BatchSize": 50
    }
  },
  "SimulatedIdentity": {
    "UserIdentifier": "mvp-operator",
    "UserDisplayName": "Nagomi Operator",
    "RequestingOrganizationIdentifier": "requesting-organization",
    "RequestingOrganizationName": "Nagomi Requesting Organization"
  },
  "Cors": {
    "Origins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
