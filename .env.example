# Copy to .env and replace every change-me value before deployment.
POSTGRES_DB=nagomi
POSTGRES_USER=nagomi
POSTGRES_PASSWORD=change-me-long-random-postgres-password

RABBITMQ_USER=nagomi
RABBITMQ_PASSWORD=change-me-long-random-rabbitmq-password
RABBITMQ_VHOST=nagomi
# Production deployments should use amqps:// and provision per-provider consumers externally.
RABBITMQ_URI=

ASPNETCORE_ENVIRONMENT=Production
OAUTH_ISSUER=https://nagomi.example.com
# Mount a production signing certificate through an environment-specific Compose override.
OAUTH_SIGNING_CERTIFICATE_PATH=
OAUTH_SIGNING_CERTIFICATE_PASSWORD=
OAUTH_ENCRYPTION_CERTIFICATE_PATH=
OAUTH_ENCRYPTION_CERTIFICATE_PASSWORD=
# Optional one-time integration client bootstrap. Keep disabled after provisioning.
OAUTH_BOOTSTRAP_ENABLED=false
OAUTH_BOOTSTRAP_CLIENT_ID=
OAUTH_BOOTSTRAP_CLIENT_SECRET=
OAUTH_BOOTSTRAP_DISPLAY_NAME=
OAUTH_BOOTSTRAP_PROVIDER_ID=00000000-0000-0000-0000-000000000000
OAUTH_BOOTSTRAP_ROLE=operator
OAUTH_BOOTSTRAP_CONTRACT=

SIMULATED_ACTOR_ID=mvp-operator
SIMULATED_ORGANIZATION_ID=requesting-organization

# Usuario administrador inicial creado al arrancar (roles: admin). Cámbialo antes de exponer el servicio.
NAGOMI_ADMIN_EMAIL=admin@nagomi.local
NAGOMI_ADMIN_PASSWORD=change-me-admin-password-123

# Keep the frontend bound to loopback unless a TLS reverse proxy is in front of it.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
VITE_API_BASE_URL=/api

# Optional OpenTelemetry collector endpoint, for example http://otel-collector:4317.
OTEL_EXPORTER_OTLP_ENDPOINT=
